# Shell assignments, sourced only by run.sh. Keep this file private (0600).
# init-config.py generates the 32-character master key; never copy a sample key.
HERDR_RELAY_TOKEN=REPLACE_WITH_RANDOM_32_CHARACTERS
HERDR_GATEWAY_URL=tcp://203.0.113.10:8377
HERDR_GATEWAY_REGISTRATION_TOKEN=REPLACE_WITH_GATEWAY_REGISTRATION_SECRET
HERDR_RELAY_HOST=127.0.0.1
HERDR_RELAY_PORT=8375
HERDR_RELAY_PLUGIN_PORT=8376
HERDR_TRANSPORT_FORCE_RELAY=1
HERDR_REACHABILITY_PORT_MAPPING=0
HERDR_BIN=/absolute/path/to/herdr
HERDR_SOCKET_PATH=/home/YOUR_USER/.config/herdr/herdr.sock
